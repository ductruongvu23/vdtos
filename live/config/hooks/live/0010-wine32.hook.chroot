#!/usr/bin/env bash
set -euo pipefail

dpkg --add-architecture i386
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  wine32:i386 libgl1:i386 libgl1-mesa-dri:i386 libasound2-plugins:i386

if ! find /usr/lib -path '*/wine/i386-windows/notepad.exe' -print -quit | grep -q .; then
  echo "ERROR: 32-bit Wine notepad.exe (i386-windows) not found after installing wine32:i386" >&2
  exit 1
fi
