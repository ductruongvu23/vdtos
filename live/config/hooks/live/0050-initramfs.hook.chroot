#!/usr/bin/env bash
set -euo pipefail

found=0
for moddir in /lib/modules/*; do
  [[ -d "$moddir" ]] || continue
  found=1
  ver="$(basename "$moddir")"
  if [[ ! -f "/boot/initrd.img-${ver}" ]]; then
    update-initramfs -c -k "$ver"
  fi
done

if (( found == 0 )); then
  echo "ERROR: no kernel modules directory found under /lib/modules" >&2
  exit 1
fi
