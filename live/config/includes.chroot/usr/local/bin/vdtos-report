#!/usr/bin/env bash
set -euo pipefail

boot_seconds() {
  local input="$1"
  awk '
    /graphical\.target/ {
      total = 0
      for (i = 1; i <= NF; i++) {
        v = $i
        if (v ~ /^[0-9]+(\.[0-9]+)?h$/) {
          sub(/h$/, "", v)
          total += v * 3600
        } else if (v ~ /^[0-9]+(\.[0-9]+)?min$/) {
          sub(/min$/, "", v)
          total += v * 60
        } else if (v ~ /^[0-9]+(\.[0-9]+)?ms$/) {
          sub(/ms$/, "", v)
          total += v / 1000
        } else if (v ~ /^[0-9]+(\.[0-9]+)?s$/) {
          sub(/s$/, "", v)
          total += v
        }
      }
      printf "%.15g\n", total
      exit
    }
  ' <<< "$input"
}

mem_used_mb() {
  local input="$1"
  awk '/^Mem:/ { print $3; exit }' <<< "$input"
}

main() {
  systemctl is-system-running --wait || true

  local boot mem
  boot="$(boot_seconds "$(systemd-analyze)")"
  mem="$(mem_used_mb "$(free -m)")"

  {
    printf 'VDTOS-BOOT %s\n' "$boot"
    printf 'VDTOS-MEM %s\n' "$mem"
  } > /dev/ttyS0
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
