#!/usr/bin/env bash
set -euo pipefail

lb config noauto \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --linux-packages none \
  --apt-recommends false \
  --debian-installer live \
  --iso-volume VDTOS --image-name vdtos \
  --bootappend-live "boot=live components quiet splash preempt=full" \
  "${@}"
