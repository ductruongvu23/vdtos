#!/usr/bin/env python3
"""VDTOS Wine settings GUI (Python 3 + GTK 3)."""

import argparse
import os
import subprocess
import threading


def get_wine_prefix():
    return os.environ.get("WINEPREFIX") or os.path.expanduser("~/.wine")


def get_wine_version():
    try:
        out = subprocess.check_output(
            ["wine", "--version"], stderr=subprocess.STDOUT, text=True, timeout=5
        )
        return out.strip()
    except (OSError, subprocess.SubprocessError):
        return "Chưa cài đặt"


def execute_command(cmd, dry_run=False):
    if dry_run:
        print(" ".join(cmd))
        return 0, ""
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or f"Mã lỗi {proc.returncode}").strip()
        return proc.returncode, err
    return 0, ""


def run_self_test(dry_run=True):
    prefix = get_wine_prefix()
    commands = [
        ["vdtos-wine", "apply-theme", "dark"],
        ["vdtos-wine", "apply-theme", "light"],
        ["vdtos-wine", "set-dpi", "96"],
        ["vdtos-wine", "set-dpi", "120"],
        ["vdtos-wine", "set-dpi", "144"],
        ["winecfg", "-v", "win10"],
        ["winecfg", "-v", "win7"],
        ["winecfg", "-v", "winxp"],
        ["winecfg"],
        ["xdg-open", os.path.join(prefix, "drive_c")],
        ["wine", "uninstaller"],
        ["vdtos-wine", "reset"],
    ]
    for cmd in commands:
        rc, err = execute_command(cmd, dry_run=dry_run)
        if rc != 0:
            raise RuntimeError(f"Command failed ({cmd}): {err}")


def launch_gui(dry_run=False):
    import gi

    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk

    class WineSettingsWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="Tinh chỉnh Wine")
            self.set_default_size(460, 380)
            self.set_border_width(16)
            self.set_icon_name("wine")

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            self.add(vbox)

            # Status frame
            status_frame = Gtk.Frame(label="Trạng thái")
            status_grid = Gtk.Grid(column_spacing=12, row_spacing=6, margin=10)
            status_frame.add(status_grid)
            vbox.pack_start(status_frame, False, False, 0)

            self.ver_label = Gtk.Label(label=get_wine_version(), xalign=0)
            self.prefix_label = Gtk.Label(label=get_wine_prefix(), xalign=0)
            self.state_label = Gtk.Label(label="", xalign=0)

            status_grid.attach(Gtk.Label(label="Phiên bản Wine:", xalign=0), 0, 0, 1, 1)
            status_grid.attach(self.ver_label, 1, 0, 1, 1)
            status_grid.attach(Gtk.Label(label="Thư mục prefix:", xalign=0), 0, 1, 1, 1)
            status_grid.attach(self.prefix_label, 1, 1, 1, 1)
            status_grid.attach(Gtk.Label(label="Tình trạng:", xalign=0), 0, 2, 1, 1)
            status_grid.attach(self.state_label, 1, 2, 1, 1)
            self._refresh_status()

            # Settings grid
            cfg_frame = Gtk.Frame(label="Tùy chỉnh hiển thị & tương thích")
            cfg_grid = Gtk.Grid(column_spacing=12, row_spacing=10, margin=10)
            cfg_frame.add(cfg_grid)
            vbox.pack_start(cfg_frame, False, False, 0)

            # Theme
            cfg_grid.attach(Gtk.Label(label="Giao diện app Windows:", xalign=0), 0, 0, 1, 1)
            theme_box = Gtk.Box(spacing=6)
            btn_dark = Gtk.Button(label="Tối")
            btn_light = Gtk.Button(label="Sáng")
            btn_dark.connect("clicked", lambda *_: self._run_async(["vdtos-wine", "apply-theme", "dark"], "Đã áp dụng giao diện Tối"))
            btn_light.connect("clicked", lambda *_: self._run_async(["vdtos-wine", "apply-theme", "light"], "Đã áp dụng giao diện Sáng"))
            theme_box.pack_start(btn_dark, True, True, 0)
            theme_box.pack_start(btn_light, True, True, 0)
            cfg_grid.attach(theme_box, 1, 0, 1, 1)

            # DPI
            cfg_grid.attach(Gtk.Label(label="Cỡ chữ / DPI:", xalign=0), 0, 1, 1, 1)
            dpi_combo = Gtk.ComboBoxText()
            dpi_options = [("96", "100% (96 DPI)"), ("120", "125% (120 DPI)"), ("144", "150% (144 DPI)")]
            for val, text in dpi_options:
                dpi_combo.append(val, text)
            dpi_combo.set_active(0)
            btn_dpi = Gtk.Button(label="Áp dụng")
            btn_dpi.connect(
                "clicked",
                lambda *_: self._run_async(
                    ["vdtos-wine", "set-dpi", dpi_combo.get_active_id() or "96"],
                    "Đã cập nhật DPI",
                ),
            )
            dpi_box = Gtk.Box(spacing=6)
            dpi_box.pack_start(dpi_combo, True, True, 0)
            dpi_box.pack_start(btn_dpi, False, False, 0)
            cfg_grid.attach(dpi_box, 1, 1, 1, 1)

            # Windows version
            cfg_grid.attach(Gtk.Label(label="Phiên bản Windows:", xalign=0), 0, 2, 1, 1)
            win_combo = Gtk.ComboBoxText()
            for val, text in [("win10", "Windows 10"), ("win7", "Windows 7"), ("winxp", "Windows XP")]:
                win_combo.append(val, text)
            win_combo.set_active(0)
            btn_win = Gtk.Button(label="Áp dụng")
            btn_win.connect(
                "clicked",
                lambda *_: self._run_async(
                    ["winecfg", "-v", win_combo.get_active_id() or "win10"],
                    "Đã đổi phiên bản Windows",
                ),
            )
            win_box = Gtk.Box(spacing=6)
            win_box.pack_start(win_combo, True, True, 0)
            win_box.pack_start(btn_win, False, False, 0)
            cfg_grid.attach(win_box, 1, 2, 1, 1)

            # Action buttons
            actions = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
            vbox.pack_start(actions, False, False, 0)

            btn_cfg = Gtk.Button(label="Cấu hình nâng cao")
            btn_cfg.connect("clicked", lambda *_: self._run_async(["winecfg"]))
            btn_drive = Gtk.Button(label="Mở ổ C:")
            btn_drive.connect(
                "clicked",
                lambda *_: self._run_async(["xdg-open", os.path.join(get_wine_prefix(), "drive_c")]),
            )
            btn_uninst = Gtk.Button(label="Gỡ cài đặt app")
            btn_uninst.connect("clicked", lambda *_: self._run_async(["wine", "uninstaller"]))
            btn_reset = Gtk.Button(label="Đặt lại Wine")
            btn_reset.connect("clicked", self._on_reset_clicked)

            actions.attach(btn_cfg, 0, 0, 1, 1)
            actions.attach(btn_drive, 1, 0, 1, 1)
            actions.attach(btn_uninst, 0, 1, 1, 1)
            actions.attach(btn_reset, 1, 1, 1, 1)

            self.feedback_label = Gtk.Label(label="", xalign=0)
            vbox.pack_end(self.feedback_label, False, False, 0)

        def _refresh_status(self):
            prefix = get_wine_prefix()
            self.prefix_label.set_text(prefix)
            self.state_label.set_text("Đã khởi tạo" if os.path.isdir(prefix) else "Chưa khởi tạo")

        def _show_error(self, msg):
            dlg = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK,
                text="Lỗi thực thi lệnh Wine",
            )
            dlg.format_secondary_text(msg)
            dlg.run()
            dlg.destroy()

        def _run_async(self, cmd, success_msg=None):
            self.feedback_label.set_text("Đang chạy: " + " ".join(cmd))

            def worker():
                rc, err = execute_command(cmd, dry_run=dry_run)

                def on_done():
                    self._refresh_status()
                    if rc != 0:
                        self.feedback_label.set_text("Có lỗi xảy ra.")
                        self._show_error(err)
                    else:
                        self.feedback_label.set_text(success_msg or "Hoàn tất.")
                    return False

                GLib.idle_add(on_done)

            threading.Thread(target=worker, daemon=True).start()

        def _on_reset_clicked(self, *_args):
            dlg = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.QUESTION,
                buttons=Gtk.ButtonsType.YES_NO,
                text="Đặt lại Wine?",
            )
            dlg.format_secondary_text(
                "Thư mục prefix hiện tại sẽ được sao lưu trước khi tạo lại môi trường Wine mới."
            )
            resp = dlg.run()
            dlg.destroy()
            if resp == Gtk.ResponseType.YES:
                self._run_async(["vdtos-wine", "reset"], "Đã đặt lại Wine")

    win = WineSettingsWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


def main():
    parser = argparse.ArgumentParser(description="Tinh chỉnh Wine cho VDTOS")
    parser.add_argument("--dry-run", action="store_true", help="In lệnh thay vì chạy")
    parser.add_argument(
        "--self-test", action="store_true", help="Kiểm tra các lệnh sẽ gọi không cần màn hình"
    )
    args = parser.parse_args()

    if args.self_test:
        run_self_test(dry_run=args.dry_run)
        return

    launch_gui(dry_run=args.dry_run)


if __name__ == "__main__":
    main()
